# ─── Google OAuth (NextAuth login) ───────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# REQUIRED — without this, token encryption will fail at runtime
NEXTAUTH_SECRET=your-nextauth-secret-32-chars-min
NEXTAUTH_URL=http://localhost:3000

# ─── Google Service Account (for GA4 + server-side Google APIs) ──────────────
# Create at: https://console.cloud.google.com/iam-admin/serviceaccounts
# 1. Create a service account and download the JSON key
# 2. Grant the service account "Viewer" access to your GA4 property
# 3. Enable "Google Analytics Data API" in Google Cloud Console
# 4. Paste the entire JSON key file content here as a single-line string
# REQUIRED — every GA4 data fetch depends on this
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# ─── Google Analytics 4 ──────────────────────────────────────────────────────
# The numeric property ID — found in GA4 Admin → Property Settings
GA4_PROPERTY_ID=123456789

# ─── Apple Sign In ───────────────────────────────────────────────────────────
# Register at: https://developer.apple.com/account/resources/identifiers/list/serviceId
# APPLE_ID=com.yourapp.service-id
# APPLE_SECRET=<your-p8-private-key-content>

# ─── Microsoft / Azure AD ─────────────────────────────────────────────────────
# Register at: https://portal.azure.com → Azure Active Directory → App registrations
# AZURE_AD_CLIENT_ID=your-azure-client-id
# AZURE_AD_CLIENT_SECRET=your-azure-client-secret
# AZURE_AD_TENANT_ID=common   # or your specific tenant ID

# ─── Google Ads ──────────────────────────────────────────────────────────────
# NOTE: Use a SEPARATE OAuth client from the NextAuth login client above.
# The Ads API requires the client to be approved in Google Ads API Center.
# Developer token: https://ads.google.com/aw/apicenter
GOOGLE_ADS_CLIENT_ID=your-google-ads-client-id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your-google-ads-client-secret
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
GOOGLE_ADS_CUSTOMER_ID=1234567890

# ─── Meta (Facebook) Ads ─────────────────────────────────────────────────────
# Create app at: https://developers.facebook.com/apps
# Requires: ads_read, business_management scopes
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_AD_ACCOUNT_ID=act_123456789

# ─── LinkedIn Ads ─────────────────────────────────────────────────────────────
# Create app at: https://www.linkedin.com/developers/apps
# Requires LinkedIn Marketing Developer Platform access
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_AD_ACCOUNT_ID=123456789

# ─── TikTok Ads ──────────────────────────────────────────────────────────────
# Apply at: https://ads.tiktok.com/marketing_api/homepage
TIKTOK_APP_ID=your-tiktok-app-id
TIKTOK_APP_SECRET=your-tiktok-app-secret
TIKTOK_ADVERTISER_ID=your-advertiser-id

# ─── Snapchat Ads ─────────────────────────────────────────────────────────────
# Apply at: https://businesshelp.snapchat.com/s/article/api-apply
SNAPCHAT_CLIENT_ID=your-snapchat-client-id
SNAPCHAT_CLIENT_SECRET=your-snapchat-client-secret
SNAPCHAT_AD_ACCOUNT_ID=your-ad-account-id

# ─── Microsoft / Bing Ads ─────────────────────────────────────────────────────
# Register app at: https://developers.ads.microsoft.com/
BING_CLIENT_ID=your-bing-client-id
BING_CLIENT_SECRET=your-bing-client-secret

# ─── Shopify ─────────────────────────────────────────────────────────────────
# Create a Shopify app at: https://partners.shopify.com
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret

# ─── Google Search Console ───────────────────────────────────────────────────
# Your verified property URL (must be verified in Search Console)
SEARCH_CONSOLE_SITE_URL=https://example.com/

# ─── YouTube Analytics ───────────────────────────────────────────────────────
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxx

# ─── Salesforce ──────────────────────────────────────────────────────────────
# Create a Connected App in Salesforce Setup → App Manager
SALESFORCE_CLIENT_ID=your-connected-app-consumer-key
SALESFORCE_CLIENT_SECRET=your-connected-app-consumer-secret
SALESFORCE_INSTANCE_URL=https://yourorg.salesforce.com

# ─── X / Twitter Ads ─────────────────────────────────────────────────────────
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret

# ─── Google Tag Manager ──────────────────────────────────────────────────────
# Found in GTM Admin → Container snippet (format: GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Optional: Redis cache (for GA4 response caching) ────────────────────────
# REDIS_URL=redis://localhost:6379

# ─── Optional: Database (Prisma + PostgreSQL / Supabase) ─────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/ga4_dashboard
