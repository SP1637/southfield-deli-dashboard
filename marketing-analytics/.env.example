# ─── Google OAuth (NextAuth) ──────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-32-chars-min
NEXTAUTH_URL=http://localhost:3000

# ─── Google Analytics 4 ──────────────────────────────────────────────────────
# Enable "Google Analytics Data API" in Google Cloud Console
# The property ID is found in GA4 Admin → Property Settings (numeric, e.g. 123456789)
GA4_PROPERTY_ID=123456789

# ─── Google Tag Manager ──────────────────────────────────────────────────────
# Found in GTM Admin → Container snippet (format: GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Optional: Redis cache (for GA4 response caching) ────────────────────────
# REDIS_URL=redis://localhost:6379

# ─── Optional: Database (Prisma + PostgreSQL / Supabase) ─────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/ga4_dashboard
