# ──────────────────────────────────────────────
# Nexoryx One — Environment Variables
# Copy to .env.local and fill in real values
# ──────────────────────────────────────────────

# ── NextAuth ──────────────────────────────────
NEXTAUTH_SECRET=your-secret-at-least-32-chars
NEXTAUTH_URL=https://nexoryxone.com

# ── Google OAuth (login + GA4) ───────────────
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# ── Supabase ──────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── GA4 (Service Account) ─────────────────────
# Used for server-side GA4 Data API calls
# Set ONE of these — service account JSON is preferred:
GA4_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GA4_PROPERTY_ID=123456789

# ── Google Ads ────────────────────────────────
GOOGLE_ADS_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=GOCSPX-xxxx
GOOGLE_ADS_DEVELOPER_TOKEN=xxxx
GOOGLE_ADS_CUSTOMER_ID=123-456-7890

# ── Meta (Facebook/Instagram) Ads ────────────
META_APP_ID=xxxx
META_APP_SECRET=xxxx

# ── Shopify ───────────────────────────────────
SHOPIFY_API_KEY=xxxx
SHOPIFY_API_SECRET=xxxx

# ── TikTok Ads ────────────────────────────────
TIKTOK_APP_ID=xxxx
TIKTOK_APP_SECRET=xxxx

# ── LinkedIn Ads ──────────────────────────────
LINKEDIN_CLIENT_ID=xxxx
LINKEDIN_CLIENT_SECRET=xxxx

# ── Stripe ────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxx

# ── Email (Resend) ────────────────────────────
RESEND_API_KEY=re_xxxx

# ── Vercel Cron Security ──────────────────────
# Vercel sets this automatically for cron jobs.
# For local testing, generate any random string.
CRON_SECRET=your-random-cron-secret
